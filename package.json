{
  "name": "nexora",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeamlake/nexora.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  },
  "scripts": {
    "start": "npm run mobile:start",
    "mobile:start": "npm run start --workspace @nexora/mobile",
    "android": "npm run android --workspace @nexora/mobile",
    "ios": "npm run ios --workspace @nexora/mobile",
    "web": "npm run web --workspace @nexora/mobile",
    "api:start:dev": "npm run start:dev --workspace @nexora/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run prisma:generate --workspace @nexora/api",
    "db:migrate": "npm run db:generate && npm run prisma:deploy --workspace @nexora/api",
    "db:reset": "npm run prisma:reset --workspace @nexora/api",
    "db:seed": "npm run prisma:seed --workspace @nexora/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor": "npm run doctor --workspace @nexora/mobile",
    "check": "npm run db:generate && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e && npm run build && npm run doctor"
  },
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8"
}
